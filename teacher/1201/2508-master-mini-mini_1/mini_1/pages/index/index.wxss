/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.item {
  border: 2px solid red;
}
input {
  background: #ccc;
}
.obj {
  padding: 20px;
  border: 3px solid green;
}
.btns {
  display: flex;
}
.btns button {
  margin: 0;
}
.item-wrap {
  border: 3px blue solid;
}